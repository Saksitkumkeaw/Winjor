# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจาก Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# คีย์ลับ ห้าม commit และห้ามใส่ NEXT_PUBLIC_ นำหน้า
SUPABASE_SECRET_KEY=sb_secret_your_key

# ใช้คีย์ test เท่านั้นระหว่างพัฒนา
NEXT_PUBLIC_OMISE_PUBLIC_KEY=pkey_test_your_key
OMISE_SECRET_KEY=skey_test_your_key
